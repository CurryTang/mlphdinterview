      "fontSize": 28,
      "fontFamily": 1,
      "text": "2. Non-functional requirements",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. Non-functional requirements",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t66",
      "type": "text",
      "x": 1890,
      "y": 445,
      "width": 499.9085998535156,
      "height": 166.25,
      "angle": 0,
      "strokeColor": "#1f1f1f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1316744780,
      "version": 2,
      "versionNonce": 1373834945,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789872395602,
      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 1,
      "text": "Latency: common puzzle P95 < 10 s\nHard timeout: 10 min; async is allowed\nScale: ~100 new jobs/s peak; 1,000+ concurrent\nCorrectness: exact constraints; timeout ≠ UNSAT\nReliability: lease + retry on worker crash\nIsolation: per-tenant / per-job CPU & memory budget\nReproducibility: pin dictionary + solver version",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Latency: common puzzle P95 < 10 s\nHard timeout: 10 min; async is allowed\nScale: ~100 new jobs/s peak; 1,000+ concurrent\nCorrectness: exact constraints; timeout ≠ UNSAT\nReliability: lease + retry on worker crash\nIsolation: per-tenant / per-job CPU & memory budget\nReproducibility: pin dictionary + solver version",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t67",
      "type": "text",
      "x": 1885,
      "y": 680,
      "width": 423.35980224609375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1f1f1f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1173176906,
      "version": 2,
      "versionNonce": 2013851003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789872395602,
      "link": null,
      "locked": false,
      "fontSize": 28,
      "fontFamily": 1,
      "text": "3. Back-of-envelope estimation",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. Back-of-envelope estimation",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "t68",
      "type": "text",
      "x": 1890,
      "y": 730,
      "width": 451.0786437988281,
      "height": 261.25,
      "angle": 0,
      "strokeColor": "#1f1f1f",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 136824486,
      "version": 2,
      "versionNonce": 1204685688,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789872395602,
      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 1,
      "text": "Peak submissions: 100 jobs/s\nAvg compute assumption: 2 CPU-s/job\nBase compute: 100 × 2 = 200 vCPU\n2× headroom: ≈ 400 vCPU baseline pool\n100 jobs/s × 10 s ≈ 1,000 active jobs\n\nDictionary: 1M words × ~10 chars ≈ 10 MB raw\nDense positional bitmap index ≈ 32.5 MB\nPractical worker footprint: ~50–200+ MB\n\nDominant risk: heavy-tail CPU, not storage/QPS",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Peak submissions: 100 jobs/s\nAvg compute assumption: 2 CPU-s/job\nBase compute: 100 × 2 = 200 vCPU\n2× headroom: ≈ 400 vCPU baseline pool\n100 jobs/s × 10 s ≈ 1,000 active jobs\n\nDictionary: 1M words × ~10 chars ≈ 10 MB raw\nDense positional bitmap index ≈ 32.5 MB\nPractical worker footprint: ~50–200+ MB\n\nDominant risk: heavy-tail CPU, not storage/QPS",
      "autoResize": true,
      "lineHeight": 1.25
    },
